<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only; see CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] in the project.

	     A simulator build is signed ad hoc, with no provisioning profile, so it gets no
	     application-identifier of its own. Without one the Keychain refuses every write with
	     errSecMissingEntitlement (-34018), IosSecureEncrypt cannot keep a key, and the client
	     cannot store a pairing secret - so pairing with a master silently did nothing.

	     Naming the bundle id here gives the app the identifier and the keychain group it would
	     have had from a profile. The simulator reads these from the __TEXT,__entitlements section
	     of the binary, which is why `codesign -d --entitlements` prints an empty dict for a
	     simulator build even when this file was applied.

	     A device build must NOT use this file: there the profile supplies the real entitlements,
	     with the team prefix. That is why the build setting is keyed to the simulator SDK. -->
	<key>application-identifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
