<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Compose Multiplatform refuses to start without this key: without it iOS caps the app at 60 Hz
	  on 120 Hz iPhones. Xcode only turns a known list of INFOPLIST_KEY_* build settings into plist
	  entries, and this key is not on that list, so it needs a real file. GENERATE_INFOPLIST_FILE
	  stays on and Xcode merges the generated entries into this one.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  Required before Core Location may be asked for anything. iOS terminates an app that requests
	  location without a usage description, so this has to exist before IosLastKnownLocation runs -
	  which it does the first time an automation location trigger is evaluated.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AAPS uses your location only to evaluate automation rules you set up yourself, such as starting a temporary target when you arrive somewhere.</string>
	<!--
	  Export compliance. AAPS uses only exempt cryptography - HTTPS to Nightscout, and Apple's own
	  Keychain and CryptoKit for the export password. Without this key every upload stops in App
	  Store Connect waiting for the question to be answered by hand, which would make an automatic
	  TestFlight upload not automatic at all.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Which configuration built this, substituted by Xcode. Read back by `IosClientConfig`, which used
	  to answer "debug" and `DEBUG = true` whatever it was built as - so a TestFlight build would have
	  told the user it was a development build, and `isDev()` would have been true in front of real
	  users.
	-->
	<key>AAPSBuildType</key>
	<string>$(CONFIGURATION)</string>
</dict>
</plist>
