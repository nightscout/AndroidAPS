    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">Pod felhelyezése</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">Készítse elő a szúrási helyet. Vegye le a Pod tűvédő kupakját és a ragasztó védőfóliáját, majd helyezze fel a Pod-ot a szúrási helyre.\n\nHa a kanül kilóg, nyomja meg a <b>Mégse</b> gombot, és dobja ki a Pod-ot.\n\nNyomja meg a <b>Tovább</b> gombot a kanül behelyezéséhez és a bázisbeadás indításához.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">Ha megnyomja az <b>OK</b> gombot, a kanül behelyezése megtörténik. Győződjön meg róla, hogy a Pod-ot felhelyezte a szúrási helyre.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">Kanül behelyezése</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">A kezdeti bázisprofil beállítása és a kanül behelyezése folyamatban.\n\nHa a kanül behelyezése sikerült, nyomja meg a <b>Tovább</b> gombot.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">Pod aktiválva</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">Az új Pod most aktív.\n\nA bázisprofil be van programozva, és a kanül be van helyezve.\n\nEllenőrizze, hogy a kanül megfelelően van-e behelyezve, és cserélje le a Pod-ot, ha úgy gondolja, hogy nem.</string>
    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">Pod deaktiválása</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">Nyomja meg a <b>Tovább</b> gombot a Pod deaktiválásához.\n\n<b>Megjegyzés:</b> ez minden inzulinbeadást felfüggeszt, és deaktiválja a Pod-ot.</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_confirmation">A deaktivált Pod nem használható újra. Deaktiválja most ezt a Pod-ot?</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_title">Pod deaktiválása folyamatban</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_text">A Pod deaktiválása folyamatban.\n\nHa a deaktiválás sikeresen befejeződött, nyomja meg a <b>Tovább</b> gombot.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_title">Pod deaktiválva</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_text">A Pod deaktiválva.\n\nVegye le a Pod-ot a testéről, és adja le újrahasznosításra.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_title">Pod elvetve</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_text">A Pod állapota elvetve. Az inzulinbeadás nincs felfüggesztve, mert a Pod nem lett megfelelően deaktiválva!\n\nVegye le a Pod-ot a testéről, és adja le újrahasznosításra.</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod_confirmation">Ha elveti a Pod-ot, többé nem tud vele kommunikálni. Ezt csak akkor tegye, ha a Pod-dal minden kommunikáció tartósan sikertelen. Biztosan elveti a Pod-ot?</string>
