    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">הדביקו את הפוד</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">הכינו את אתר העירוי. הסירו את מכסה המחט של הפוד ואת כיסוי הדבק והדביקו את הפוד לאתר העירוי.\n\nאם הצינורית בולטת, לחצו על <b>ביטול</b> והיפטרו מהפוד.\n\nלחצו <b>הבא</b> כדי להכניס את הצינורית ולהתחיל מתן בזאלי.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">בלחיצה על <b>אישור</b> הצינורית תוכנס. יש לוודא שהפוד הוצמד לאתר העירוי.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">הכנסת צינורית</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">מנסה להגדיר לו\"ז בזאלי התחלתי ולהכניס את הצינורית.\n\nכאשר הצינורית תוכנס בהצלחה, ניתן יהיה ללחוץ <b>הבא</b>.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">הפוד הופעל</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">הפוד החדש פעיל כעת.\n\nהלו\"ז הבזאלי הוגדר והצינורית הוכנסה.\n\nאנא ודאו כי הצינורית הוכנסה כהלכה, אם לדעתכם היא לא, יש להחליף את הפוד.</string>
    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">השבתת פוד</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">לחצו <b>הבא</b> כדי להשבית את הפוד.\n\n<b>הערה:</b> פעולה זו תשהה כל הזרקת אינסולין ותשבית את הפוד.</string>
