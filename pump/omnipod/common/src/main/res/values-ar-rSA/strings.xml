    <!-- Omnipod - Pod Activation Wizard -->
    <string name="omnipod_common_pod_activation_wizard_start_pod_activation_title">تعبئة المضخة اللاصقة</string>
    <string name="omnipod_common_pod_activation_wizard_initialize_pod_title">تهيئة المضخة اللاصقة</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">تركيب المضخة اللاصقة</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">قم بتحضير موقع الحقن. انزع غطاء إبرة المضخة اللاصقة وشريط الحماية اللاصق ثم ثبت المضخة اللاصقة في موقع الحقن.\n\nإذا كانت القنية بارزة للخارج، فيرجى الضغط على <b>إلغاء</b> والتخلص من المضخة اللاصقة.\n\nاضغط على <b>التالي</b> لإدخال القنية وبدء ضخ الأنسولين القاعدي.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">عندما تضغط على <b>موافق</b>، سيتم إدخال القنية. تأكد من أنك قمت بتركيب المضخة اللاصقة على موقع الحقن.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">إدخال القنية</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">جاري محاولة تعيين جدول الأنسولين القاعدي الأولي وإدخال القنية.\n\nعندما يتم إدخال القنية بنجاح، يمكنك الضغط على <b>التالي</b>.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">تم تفعيل المضخة اللاصقة</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">المضخة اللاصقة الجديدة نشطة الآن.\n\nتمت برمجة جدول معدل الأنسولين القاعدي الخاص بك وتم إدخال القنية.\n\nيرجى التحقق من إدخال القنية بشكل صحيح وتغيير المضخة اللاصقة إذا كنت تعتقد خلاف ذلك.</string>
    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">إلغاء تفعيل المضخة اللاصقة</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">اضغط على <b>التالي</b> لإلغاء تفعيل المضخة اللاصقة.\n\n<b>ملاحظة:</b> سيؤدي ذلك إلى تعليق جميع عمليات ضخ الأنسولين وإلغاء تفعيل المضخة اللاصقة.</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_confirmation">لا يمكن استخدام المضخة اللاصقة التي تم إلغاء تفعيلها مرة أخرى. هل تريد إلغاء تفعيل هذه المضخة اللاصقة الآن؟</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_title">جاري إلغاء تفعيل المضخة اللاصقة</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_text">جاري إلغاء تفعيل المضخة اللاصقة.\n\nعند اكتمال إلغاء التفعيل بنجاح، يمكنك الضغط على <b>التالي</b>.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_title">تم إلغاء تفعيل المضخة اللاصقة</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_text">تم إلغاء تفعيل المضخة اللاصقة الخاصة بك.\n\nيرجى إزالة المضخة اللاصقة من جسمك وإعادة تدويرها.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_title">تم التخلص من المضخة اللاصقة</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_text">تم حذف حالة المضخة اللاصقة. لم يتم تعليق ضخ الأنسولين لعدم إلغاء تفعيل المضخة اللاصقة بشكل صحيح!\n\nيرجى إزالة المضخة اللاصقة من جسمك وإعادة تدويرها.</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod_confirmation">إذا قمت بالتخلص من المضخة اللاصقة، فلن تتمكن من الاتصال بها بعد الآن. يجب ألا تقوم بذلك إلا عندما يفشل كل اتصال بالمضخة اللاصقة بشكل مستمر. هل أنت متأكد من رغبتك في التخلص من المضخة اللاصقة؟</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod">التخلص من المضخة اللاصقة</string>
