    <!-- Omnipod - Pod Activation Wizard -->
    <string name="omnipod_common_pod_activation_wizard_start_pod_activation_title">Napuni Pod</string>
    <string name="omnipod_common_pod_activation_wizard_initialize_pod_title">Inicijalizuj Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">Zalepi Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">Pripremite mesto infuzije. Uklonite zaštitni poklopac sa igle i zaštitnu foliju sa lepljive površine Pod-a, zatim zalepite Pod na mesto infuzije.\n\nAko kanila viri, pritisnite <b>Otkaži</b> i odbacite Pod.\n\nPritisnite <b>Dalje</b> da ubacite kanilu i započnete isporuku bazala.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">Kada pritisnete <b>OK</b>, kanila će biti ubačena. Uverite se da ste Pod već zalepili na mesto infuzije.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">Ubacivanje kanile</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">Pokušava se podešavanje početnog bazalnog rasporeda i ubacivanje kanile.\n\nKada kanila bude uspešno ubačena, možete pritisnuti <b>Dalje</b>.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">Pod aktiviran</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">Novi Pod je sada aktivan.\n\nVaš bazalni raspored je programiran i kanila je ubačena.\n\nProverite da li je kanila pravilno ubačena i zamenite Pod ako mislite da nije.</string>
    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">Deaktiviraj Pod</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">Pritisnite <b>Dalje</b> da deaktivirate Pod.\n\n<b>Napomena:</b> Ovo će pauzirati svu isporuku insulina i deaktivirati Pod.</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_confirmation">Deaktivirani Pod ne može ponovo da se koristi. Deaktivirati ovaj Pod sada?</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_title">Deaktivacija Pod-a</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_text">Deaktiviranje Pod-a.\n\nKada deaktivacija uspešno bude završena, možete pritisnuti <b>Dalje</b>.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_title">Pod deaktiviran</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_text">Vaš Pod je deaktiviran.\n\nUklonite Pod sa tela i odložite ga na odgovarajući način.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_title">Pod odbačen</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_text">Stanje Pod-a je odbačeno. Isporuka insulina nije pauzirana jer Pod nije pravilno deaktiviran!\n\nUklonite Pod sa tela i odložite ga na odgovarajući način.</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod_confirmation">Ako odbacite Pod, više nećete moći da komunicirate sa njim. Ovo bi trebalo da uradite samo ako sva komunikacija sa Pod-om stalno ne uspeva. Da li ste sigurni da želite da odbacite Pod?</string>
