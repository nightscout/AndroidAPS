    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">Pričvrsti Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">Pripremite mjesto primjene. Skinite zaštitnu kapicu igle Pod-a i zaštitnu foliju s ljepljivog dijela te pričvrstite Pod na mjesto primjene.\n\nAko kanila viri van, pritisnite <b>Otkaži</b> i odbacite Pod.\n\nPritisnite <b>Sljedeći</b> za umetanje kanile i početak isporuke bazala.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">Kada pritisnete <b>U redu</b>, kanila će biti umetnuta. Provjerite jeste li pričvrstili Pod na mjesto primjene.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">Umetni kanilu</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">Pokušavam postaviti početni bazalni raspored i umetnuti kanilu.\n\nKada je kanila uspješno umetnuta, možete pritisnuti <b>Sljedeći</b>.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">Pod aktiviran</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">Novi Pod je sada aktivan.\n\nVaš bazalni raspored je programiran i kanila je umetnuta.\n\nProvjerite je li kanila ispravno umetnuta i zamijenite Pod ako mislite da nije.</string>
    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">Deaktiviraj Pod</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">Pritisnite <b>Sljedeći</b> za deaktivaciju Pod-a.\n\n<b>Napomena:</b> Ovo će obustaviti svu isporuku inzulina i deaktivirati Pod.</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_confirmation">Deaktivirani Pod ne može se ponovno koristiti. Deaktivirati ovaj Pod sada?</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_title">Deaktiviranje Pod-a</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_text">Deaktiviranje Pod-a.\n\nKada se deaktivacija uspješno završi, možete pritisnuti <b>Sljedeći</b>.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_title">Pod deaktiviran</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_text">Vaš Pod je deaktiviran.\n\nSkinite Pod s tijela i reciklirajte ga.</string>
