    <!-- Omnipod - Pod Activation Wizard -->
    <string name="omnipod_common_pod_activation_wizard_start_pod_activation_title">Encher Pod</string>
    <string name="omnipod_common_pod_activation_wizard_initialize_pod_title">Inicializar Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">Colocar o Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">Prepare o local de infusão. Remova a tampa da agulha do Pod e o adesivo e coloque o Pod no local de infusão.\n\nSe a cânula sair, por favor, pressione <b>Cancelar</b> e descarte o Pod.\n\nPressione <b>Seguinte</b> para inserir a cânula e começar a administração da basal.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">Quando pressionar <b>OK</b>, a cânula será inserida. Certifique-se de que colocou o Pod no local de infusão.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">Inserir Cânula</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">A tentar definir o horário da basal inicial e inserir a cânula.\n\nQuando a cânula for inserida com sucesso, pode pressionar <b>Seguinte</b>.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">Pod Ativado</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">O novo Pod está ativo agora.\n\nO horário da basal foi programado e a cânula foi inserida.\n\nPor favor, verifique se a cânula foi inserida corretamente e mude o seu Pod se acha que não.</string>
    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">Desativar Pod</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">Pressione <b>Seguinte</b> para desativar o Pod.\n\n<b>Nota:</b> Isto irá suspender toda a administração de insulina e desativar o Pod.</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_confirmation">Um Pod desativado não pode voltar a ser usado. Desativar este Pod agora?</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_title">A Desativar Pod</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_text">A desativar o Pod.\n\nQuando a desativação for concluída com sucesso, pode pressionar <b>Seguinte</b>.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_title">Pod Desativado</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_text">O seu Pod foi desativado.\n\nPor favor, retire o Pod do seu corpo e recicle-o.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_title">Pod Descartado</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_text">O estado do Pod foi descartado. A administração da insulina não foi suspensa porque o Pod não foi corretamente desativado!\n\nRemova o Pod do seu corpo e recicle-o.</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod_confirmation">Se descartar o Pod, já não conseguirá comunicar com ele. Só deve fazer isso quando toda a comunicação com o Pod falhar persistentemente. Tem a certeza de que deseja descartar o Pod?</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod">Descartar Pod</string>
