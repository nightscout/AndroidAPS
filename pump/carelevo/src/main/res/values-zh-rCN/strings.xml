    <!-- Warning Descriptions -->
    <string name="alarm_feat_desc_warning_low_insulin"><![CDATA[剩余胰岛素不足 <b>10 U</b>；胰岛素输注已停止。<br><b>请点击 [停用贴片] 按钮并立即更换贴片。</b>]]></string>
