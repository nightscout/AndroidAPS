    <string name="alarm_feat_desc_warning_not_used_app"><![CDATA[已停止胰島素輸注。<br><b>請點選 [開始胰島素]，重新啟動基礎輸注。</b>]]></string>
    <string name="alarm_feat_desc_warning_incomplete_patch_setting"><![CDATA[貼片安裝時間已超時。<br><b>請點選 [停用貼片]，立即更換貼片。</b>]]></string>
    <string name="alarm_feat_desc_warning_failed_safety_check"><![CDATA[自我診斷失敗。<br><b>請點選 [停用貼片]，立即更換貼片。</b>]]></string>
    <string name="alarm_feat_desc_warning_patch_error"><![CDATA[發生非預期錯誤，已停止胰島素輸注。<br><b>請點選 [停用貼片]，立即更換貼片。</b>]]></string>
    <string name="alarm_feat_desc_warning_infusion_clogged"><![CDATA[因阻塞而停止胰島素輸注。<br><b>請點選 [停用貼片]，立即更換貼片。</b>]]></string>
