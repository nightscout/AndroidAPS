    <!-- Warning Descriptions -->
    <string name="alarm_feat_desc_warning_low_insulin"><![CDATA[剩餘胰島素少於 <b>10 U</b>；已停止胰島素輸注。<br><b>請點選 [停用貼片]，立即更換貼片。</b>]]></string>
    <string name="alarm_feat_desc_warning_expired_patch"><![CDATA[貼片已到期；已停止胰島素輸注。<br><b>請點選 [停用貼片]，立即更換貼片。</b>]]></string>
