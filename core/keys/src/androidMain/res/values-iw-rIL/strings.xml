    <string name="pref_title_max_basal">קצב בזאלי מרבי</string>
    <string name="openapsma_max_basal_summary">ערך זה נקרא בזאלי מרבי ב-OpenAPS</string>
    <string name="pref_title_smb_max_iob">IOB מרבי עבור SMB</string>
    <string name="openapssmb_max_iob_summary">ערך זה נקרא Max IOB בהקשר של OpenAPS.\nOpenAPS לא יוסיף אינסולין נוסף אם ה־IOB הנוכחי גבוה מערך זה. הערך מושפע גם מסוג המטופל.</string>
    <string name="pref_title_ama_max_iob">IOB מרבי עבור AMA</string>
    <string name="openapsama_max_daily_safety_multiplier_summary">ערך ברירת מחדל: 3 מנגנון הגנה עיקרי של OpenAPS. מגביל את המינון הבזאלי לעד פי 3 מהמינון הבזאלי הגבוה ביותר שהוגדר. ברוב המקרים אין צורך לשנות ערך זה, אך יש לזכור שזו המשמעות של “3x max daily; 4x current” בדיון על מנגנוני הגנה.</string>
    <string name="openapsama_current_basal_safety_multiplier_summary">ערך ברירת מחדל: 4 זהו החצי השני של מנגנון הגנה עיקרי של OpenAPS, והחצי השני של \"3x max daily; 4x current\" במנגנוני ההגנה. המשמעות היא שהמינון הבזאלי, ללא קשר למקסימום שנקבע במשאבה, אינו יכול להיות גבוה יותר ממספר זה כפול הקצב הבזאלי הנוכחי. מיועד למנוע כניסה לתחומים מסוכנים ע\"י קביעת קצב בזאלי גבוה לפני הבנה של פעולת האלגוריתם. שוב: ברירת המחדל היא x4, רוב המשתמשים לעולם אינם צריכים לשנות ערך זה ואם הם מרגישים שמנגנון הגנה זה מפריע להם, הפתרון הוא בשינוי של הגדרות אחרות.</string>
    <string name="openapsama_bolus_snooze_dia_divisor_summary">ערך ברירת מחדל: 2\n מעכב בולוס מופעל אחרי שאתם מזריקים בולוס ארוחה, כך שהלולאה לא תפצה ע\"י בזאלי זמני נמוך אחרי הארוחה. הדוגמה כאן וברירת המחדל היא 2; כך שהגדרה של משך פעילות אינסולין של 3 שעות משמעה שהעיכוב יחלוף בהדרגה בתוך 1.5 שעות (3 ש\' לחלק ל-2).</string>
    <string name="openapsama_min_5m_carb_impact_summary">ערך ברירת מחדל: 3.0 (AMA) או 8.0 (SMB). זוהי הגדרת ברירת מחדל להשפעת פחמימות על הסוכר בדם ב-5 דקות. ברירת המחדל היא 3mg/dL/5min. פעולה זו משפיעה על קצב הדעיכה של פחמ\' פעילות, ועל הנחת קצב ספיגת הפחמ\' בחישוב רמות סוכר עתידיות כשהן בירידה מהירה מהצפוי או עליה איטית מהצפוי.</string>
    <string name="pref_title_absorption_cutoff">סף הפסקת חישוב ספיגה</string>
    <string name="absorption_cutoff_summary">משך זמן בו כל ארוחה תחשב כנספגה. לא תהיה התחשבות בפחמימות שנותרו.</string>
    <string name="pref_title_absorption_maxtime">זמן ספיגה מרבי</string>
    <string name="absorption_max_time_summary">מספר השעות בהן צפוי שכל הפחמימות מארוחה ייספגו</string>
    <string name="pref_title_autosens_min">Autosens מינימלי</string>
    <string name="openapsama_autosens_min_summary">ערך ברירת מחדל: 0.7\nבצד השני של מגבלות הבטיחות של Autosens, ערך זה מגביל את יכולתו של autosens להוריד את הערכים הבזאליים ועד כמה יכול להעלות את יחס התיקון ואת ערכי מטרת הסוכר בדם.</string>
    <string name="pref_title_autosens_max">Autosens מרבי</string>
    <string name="openapsama_autosens_max_summary">ערך ברירת מחדל: 1.2\nזוהי מגבלת המכפיל של Autosens (ובקרוב Autotune) שמגדירה 20% כיחס מקסימלי של autosens, אשר קובע בתורו את גובה הבזאלי המקסימלי, גובהו המינימלי של יחס התיקון, ואת המינימום של ערכי המטרה האפשריים.</string>
    <string name="pref_title_autoisf_min">AutoISF מינימלי</string>
    <string name="pref_title_autoisf_max">AutoISF מרבי</string>
    <string name="openapsama_autoISF_max_summary">בדומה ל־autosens_max, ערך זה מגדיר עד כמה ISF יכול להתחזק.\n\nערך ברירת המחדל 1.0 למעשה מבטל השפעה זו.\n\nאזהרה: יש לנקוט זהירות רבה בעת שימוש בערכים מעל 2.5</string>
    <string name="pref_title_bg_accel_weight">משקל ISF להאצת שינוי הסוכר</string>
    <string name="openapsama_bgAccel_ISF_weight_summary">זהו המשקל שמוחל כאשר השינוי ברמת הסוכר מאיץ, והוא מחזק את ISF ולכן עשוי להגדיל את מתן האינסולין.\n\nערך ברירת המחדל 0.0 למעשה מבטל השפעה זו.</string>
    <string name="pref_title_bg_brake_weight">משקל ISF להאטת שינוי הסוכר</string>
    <string name="openapsama_bgBrake_ISF_weight_summary">זהו המשקל שמוחל כאשר השינוי ברמת הסוכר מאט, והוא מחליש את ISF ולכן עשוי להפחית את מתן האינסולין.\n\nערך ברירת המחדל 0.0 למעשה מבטל השפעה זו.</string>
    <string name="pref_title_low_bg_weight">משקל לטווח גלוקוז נמוך</string>
    <string name="openapsama_lower_ISFrange_weight_summary">זהו המשקל שמוחל כאשר הגלוקוז מתחת לערך המטרה, והוא מחליש את ISF ולכן עשוי להפחית את מתן האינסולין.\n\nערך ברירת המחדל 0.0 למעשה מבטל השפעה זו.</string>
    <string name="pref_title_high_bg_weight">משקל לטווח סוכר גבוה</string>
    <string name="openapsama_higher_ISFrange_weight_summary">זהו המשקל שמוחל כאשר הסוכר מעל ערך המטרה, והוא מחזק את ה-ISF ולכן עשוי להגדיל את מתן האינסולין.\n\nערך ברירת המחדל 0.0 למעשה מבטל השפעה זו.</string>
    <string name="pref_title_smb_delivery_ratio_bg_range">טווח סוכר ליחס מתן SMB</string>
    <string name="pref_title_dura_weight">משקל ISF לפי משך</string>
    <string name="openapsama_dura_ISF_weight_summary">זהו המשקל שמוחל כאשר רמת הסוכר נשארת גבוהה ויציבה לאורך זמן, והוא מחזק את ISF ולכן עשוי להגדיל את מתן האינסולין.\n\nערך ברירת המחדל 0.0 למעשה מבטל השפעה זו.</string>
    <string name="pref_title_smb_delivery_ratio">יחס מתן SMB</string>
    <string name="openapsama_smb_delivery_ratio_summary">ערך ברירת מחדל: 0.5 זוהי מגבלת בטיחות נוספת של OpenAPS המגדירה איזה חלק מסך האינסולין הנדרש יכול להינתן כ-SMB. מגבלה זו נועדה למנוע כפילות הזרקת SMB הנגרמת מפקודות מהמטפל המרוחק בנוסף למכשיר הראשי. יש להגדיל ערך ניסיוני זה בהדרגה ובזהירות.</string>
    <string name="pref_title_smb_delivery_ratio_min">יחס מתן SMB מינימלי</string>
    <string name="openapsama_smb_delivery_ratio_min_summary">ערך ברירת מחדל: 0.5 זהו הקצה הנמוך של יחס שמתגבר באופן ליניארי ולא ערך קבוע כפי שמצוין לעיל.</string>
    <string name="pref_title_smb_delivery_ratio_max">יחס מתן SMB מרבי</string>
    <string name="openapsama_smb_delivery_ratio_max_summary">ערך ברירת מחדל: 0.5. זהו הקצה העליון של יחס שעולה באופן ליניארי ולא ערך קבוע כפי שמתואר לעיל.</string>
    <string name="pref_title_smb_max_range_extension">הרחבת הטווח המרבי של SMB</string>
    <string name="openapsama_smb_max_range_extension_summary">ערך ברירת מחדל: 1. זהו מנגנון בטיחות מרכזי נוסף של OpenAPS, והוא מגדיר באיזה מכפיל ניתן לחרוג ממגבלת 120 הדקות הרגילה של maxSMB/maxUAM. יש להגדיל ערך ניסיוני זה בהדרגה ובזהירות.</string>
