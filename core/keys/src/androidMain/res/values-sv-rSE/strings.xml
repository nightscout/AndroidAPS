    <!-- DoubleKey: APS preferences -->
    <string name="pref_title_max_basal">Maximal basalhastighet</string>
    <string name="openapsma_max_basal_summary">Detta värde kallas max basal i OpenAPS-sammanhang</string>
    <string name="pref_title_smb_max_iob">Max IOB för SMB</string>
    <string name="openapssmb_max_iob_summary">Detta värde kallas Max IOB i OpenAPS-sammanhang\nOpenAPS kommer inte att lägga till mer insulin om nuvarande IOB är större än detta värde. Värdet påverkas även av vald patienttyp.</string>
    <string name="pref_title_ama_max_iob">Max IOB för AMA</string>
    <string name="openapsma_max_iob_summary">Detta värde kallas Max IOB i OpenAPS-sammanhang\nDetta är maximal mängd insulin i [U] som APS kan leverera på en gång. Värdet påverkas även av vald patienttyp.</string>
    <string name="pref_title_max_daily_multiplier">Säkerhetsmultiplikator för max daglig basal</string>
    <string name="pref_title_current_basal_multiplier">Nuvarande basal säkerhetsmultiplikator</string>
    <string name="openapsama_current_basal_safety_multiplier_summary">Standardvärde: 4 Detta är den andra halvan av viktiga säkerhetsbegränsningar i OpenAPS, och den andra halvan av “3x max dagligen; 4x nuvarande“. Detta innebär att din basal, oavsett max basalinställning på pumpen, inte kan vara högre än detta värde multiplicerat med den nuvarande nivån på din basal. Detta förhindrar att du hamnar i farliga situationer genom att ställa in alltför höga max basaldoser innan du förstår hur algoritmen fungerar. Återigen är standard 4x; de flesta människor kommer aldrig att behöva justera detta utan kommer istället att justera andra inställningar om de känner att de “kör in i“ detta skyddstak.</string>
    <string name="pref_title_bolus_snooze_divisor">Bolus snooze DIA-divisor</string>
    <string name="openapsama_bolus_snooze_dia_divisor_summary">Standardvärde: 2\nBolus snooze är aktivt efter att du givit en måltidsbolus, detta för att inte loop ska lågtempa när du just ätit. I detta exempel och grundvärdet är 2; det innebär att med DIA på 3 tim kommer bolus snooze att fasas ut under 1,5 tim (3DIA/2).</string>
    <string name="pref_title_ama_min_5m_carbs_impact">AMA KH-absorption per 5 min</string>
    <string name="pref_title_smb_min_5m_carbs_impact">SMB KH-absorption per 5 min</string>
    <string name="openapsama_min_5m_carb_impact_summary">Standardvärde: 3,0 (AMA) eller 8,0 (SMB). Detta är grundinställning för KH-absorption per 5 min. Standardvärdet motsvarar 3mg/dl/5min. Detta styr hur snabbt COB räknas bort, dvs hur snabbt programmet kalkylerar att KH tagits upp, och påverkar BG framöver när BG faller mer än väntat, eller inte stiger som väntat.</string>
    <string name="pref_title_absorption_cutoff">Absorptionsgräns</string>
    <string name="absorption_cutoff_summary">Efter denna tid anses alla kolhydrater vara absorberade. Om det fortfarande finns COB, kommer dessa att tas bort ur beräkningen.</string>
    <string name="pref_title_absorption_maxtime">Max absorptionstid</string>
    <string name="pref_title_autosens_min">Autosens min</string>
    <string name="openapsama_autosens_min_summary">Standardvärde: 0,7\nDen andra sidan av autosens säkerhetsgränser, sätter ett tak på hur lågt autosens kan justera basaler, och hur högt den kan justera ISF- och BG-mål.</string>
    <string name="pref_title_autosens_max">Autosens max</string>
    <string name="openapsama_autosens_max_summary">Standardvärde: 1,2\nDetta är ett multiplikatortak för autosens (och snart autotune). Sätter en maxgräns på 20%% för hur högt autosens förhållandet kan vara, vilket i sin tur avgör hur högt autosens kan justera basaler, hur lågt det kan justera ISF, och hur lågt den kan ställa in BG målet.</string>
    <string name="pref_title_autoisf_min">AutoISF min</string>
    <string name="openapsama_autoISF_min_summary">Liknande autosens_min definierar detta hur svag ISF kan bli.\n\nStandardvärdet 1,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_autoisf_max">AutoISF max</string>
    <string name="openapsama_autoISF_max_summary">Liknande autosens_max definierar detta hur stark ISF kan bli.\n\nStandardvärdet 1,0 stänger av effekten av denna funktion.\n\nVARNING: Var extremt försiktig när du använder värden över 2,5</string>
    <string name="pref_title_bg_accel_weight">BG-acceleration ISF vikt</string>
    <string name="openapsama_bgAccel_ISF_weight_summary">Detta är den vikt som appliceras när glukosvärdet accelererar och som stärker ISF vilket potentiellt ökar insulinleveransen.\n\nStandardvärdet 0,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_bg_brake_weight">BG broms ISF vikt</string>
    <string name="openapsama_bgBrake_ISF_weight_summary">Detta är den vikt som tillämpas när glukosnivån retarderar (bromsar in) och som försvagar ISF vilket potentiellt minskar insulinleveransen.\n\nStandardvärdet 0,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_low_bg_weight">Lågt BG-intervall vikt</string>
    <string name="openapsama_lower_ISFrange_weight_summary">Detta är den vikt som appliceras när glukosnivån är under målet och som försvagar ISF vilket potentiellt minskar insulinleveransen.\n\nStandardvärdet 0,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_high_bg_weight">Högt BG-intervall vikt</string>
    <string name="openapsama_higher_ISFrange_weight_summary">Detta är den vikt som appliceras när glukosnivån är över målet och som stärker ISF vilket potentiellt ökar insulinleveransen.\n\nStandardvärdet 0,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_smb_delivery_ratio_bg_range">SMB leveransförhållande BG-intervall</string>
    <string name="openapsama_smb_delivery_ratio_bg_range_summary">Standardvärde: 0. Det linjärt ökande SMB-leveransförhållandet relaterat till glukosområdet [mål_bg, mål_bg+bg_område].\nVid mål_bg är SMB förhållandet smb_delivery_ratio_min, vid mål_bg+bg_område är det smb_delivery_ratio_max\nMed värdet 0 deaktiveras det linjärt ökande SMB-förhållandet och det fasta smb_delivery_ratio används.</string>
    <string name="pref_title_pp_weight">Post-prandial (efter måltid) ISF-vikt</string>
    <string name="openapsama_pp_ISF_weight_summary">Detta är en vikt som appliceras när glukosvärdet stiger och som stärker ISF och därmed potentiellt ökar insulinleveransen.\n\nStandardvärdet 0,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_dura_weight">Varaktighet ISF vikt</string>
    <string name="openapsama_dura_ISF_weight_summary">Detta är en vikt som appliceras vid långvariga platåer med förhöjda blodsockervärden och som stärker ISF vilket potentiellt ökar insulinleveransen.\n\nStandardvärdet 0,0 stänger av effekten av denna funktion.</string>
    <string name="pref_title_smb_delivery_ratio">SMB leveransförhållande</string>
    <string name="pref_title_smb_delivery_ratio_min">SMB leveransförhållande min</string>
    <string name="pref_title_smb_delivery_ratio_max">SMB leveransförhållande max</string>
    <string name="pref_title_smb_max_range_extension">Utökning av SMB maxintervall</string>
    <string name="openapsama_smb_max_range_extension_summary">Standardvärde: 1 Detta är en annan viktig säkerhetsgräns för OpenAPS, och anger med vilken faktor du kan överskrida de vanliga 120 maxSMB/maxUAM minuterna. Öka detta experimentella värde långsamt och med försiktighet.</string>
