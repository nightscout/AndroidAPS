    <!-- DoubleKey: APS preferences -->
    <string name="pref_title_max_basal">최대 기저 주입량</string>
    <string name="openapsma_max_basal_summary">이 값은 OpenAPS에서 max basal(최대 기저)이라고 합니다</string>
    <string name="pref_title_smb_max_iob">SMB 최대 IOB</string>
    <string name="openapssmb_max_iob_summary">이 값은 OpenAPS에서 Max IOB라고 합니다\n현재 IOB가 이 값보다 크면 OpenAPS는 인슐린을 더 추가하지 않습니다. 이 값은 환자 유형에 따라서도 달라집니다.</string>
    <string name="pref_title_ama_max_iob">AMA용 Max IOB</string>
    <string name="openapsma_max_iob_summary">이 값은 OpenAPS에서 Max IOB라고 합니다\nAPS가 한 번에 주입할 수 있는 최대 인슐린 [U]입니다. 이 값은 환자 유형에 따라서도 달라집니다.</string>
    <string name="pref_title_max_daily_multiplier">최대 일일 안전 승수</string>
    <string name="openapsama_max_daily_safety_multiplier_summary">기본값: 3 이 값은 중요한 OpenAPS 안전 한도입니다. 기저를 가장 큰 기저 주입량의 3배까지로 제한합니다. 이 값을 바꿀 필요는 거의 없지만, 안전 한도에서 말하는 “3x max daily; 4x current”가 이것이라는 점을 알아 두십시오.</string>
    <string name="pref_title_current_basal_multiplier">현재 기저 안전 배수</string>
    <string name="openapsama_current_basal_safety_multiplier_summary">기본값: 4 이 값은 또 하나의 중요한 OpenAPS 안전 한도이며, “3x max daily; 4x current” 안전 한도의 나머지 절반입니다. 펌프에 설정된 최대 기저와 관계없이, 기저는 현재 기저 주입량에 이 값을 곱한 양보다 높을 수 없습니다. 알고리즘의 작동 방식을 이해하기 전에 최대 기저를 너무 높게 설정하여 위험한 상황이 되는 것을 막기 위한 것입니다. 다시 말하지만 기본값은 4배입니다. 대부분의 사람은 이 값을 조정할 필요가 없으며, 이 안전 한도에 “걸린다”고 느낀다면 다른 설정을 조정해야 할 가능성이 더 큽니다.</string>
    <string name="pref_title_bolus_snooze_divisor">볼러스 스누즈 DIA 제수</string>
    <string name="openapsama_bolus_snooze_dia_divisor_summary">기본값: 2\n식사 볼러스 후 볼러스 스누즈가 적용되어, 방금 식사했을 때 루프가 낮은 임시 기저로 상쇄하지 않습니다. 예시이자 기본값은 2입니다. DIA가 3시간이면 볼러스 스누즈는 1.5시간(3DIA/2)에 걸쳐 점차 사라집니다.</string>
    <string name="pref_title_ama_min_5m_carbs_impact">AMA 최소 5분 탄수화물 영향</string>
    <string name="pref_title_smb_min_5m_carbs_impact">SMB 최소 5분 탄수화물 영향</string>
    <string name="openapsama_min_5m_carb_impact_summary">기본값: 3.0 (AMA) 또는 8.0 (SMB). 5분당 탄수화물이 얼만큼 흡수되었는지에 대한 기본값 설정입니다. 기본값은 3mg/dl / 5분 입니다. 이는 혈당이 예상보다 빨리 떨어지거나 혹은 예상보다 오르지 않을때, COB가 얼마나 빨리 사라지게 되는지에 영향을 주게 되고, 추정된 탄수화물 흡수량이 미래 혈당 예측 계산시에도 영향을 주게 됩니다.</string>
    <string name="pref_title_absorption_cutoff">흡수 종료 시간</string>
    <string name="absorption_cutoff_summary">식사가 모두 흡수되었다고 간주되는 시간. 나머지 탄수화물은 모두 없어집니다.</string>
    <string name="pref_title_absorption_maxtime">최대 흡수 시간</string>
    <string name="absorption_max_time_summary">식사로 섭취한 탄수화물이 모두 흡수될 것으로 예상되는 시간(시간 단위)</string>
    <string name="pref_title_autosens_min">Autosens 최소</string>
    <string name="openapsama_autosens_min_summary">기본값: 0.7\nautosens 안전 제한의 다른 쪽입니다. autosens가 기저를 얼마나 낮게, ISF와 혈당 목표를 얼마나 높게 조정할 수 있는지 제한합니다.</string>
    <string name="pref_title_autosens_max">Autosens 최대</string>
    <string name="openapsama_autosens_max_summary">기본값: 1.2\nautosens(곧 autotune도)의 배수 한도로, autosens 비율이 최대 20%% 높아질 수 있도록 제한합니다. 이 값에 따라 autosens가 기저를 얼마나 높게, ISF를 얼마나 낮게, 혈당 목표를 얼마나 낮게 조정할 수 있는지가 정해집니다.</string>
    <string name="pref_title_autoisf_min">AutoISF 최소</string>
    <string name="openapsama_autoISF_min_summary">autosens_min과 비슷하게, ISF가 얼마나 약해질 수 있는지 정합니다.\n\n기본값 1.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_autoisf_max">AutoISF 최대</string>
    <string name="openapsama_autoISF_max_summary">autosens_max와 비슷하게, ISF가 얼마나 강해질 수 있는지 정합니다.\n\n기본값 1.0은 이 효과를 사실상 끕니다.\n\n경고: 2.5보다 큰 값은 매우 주의해서 사용하십시오</string>
    <string name="pref_title_bg_accel_weight">혈당 가속 ISF 가중치</string>
    <string name="openapsama_bgAccel_ISF_weight_summary">혈당이 가속할 때 적용되는 가중치입니다. ISF를 강하게 하므로 인슐린 주입이 늘어날 수 있습니다.\n\n기본값 0.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_bg_brake_weight">혈당 감속 ISF 가중치</string>
    <string name="openapsama_bgBrake_ISF_weight_summary">혈당이 감속할 때 적용되는 가중치입니다. ISF를 약하게 하므로 인슐린 주입이 줄어들 수 있습니다.\n\n기본값 0.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_low_bg_weight">낮은 혈당 범위 가중치</string>
    <string name="openapsama_lower_ISFrange_weight_summary">혈당이 목표보다 낮을 때 적용되는 가중치입니다. ISF를 약하게 하므로 인슐린 주입이 줄어들 수 있습니다.\n\n기본값 0.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_high_bg_weight">높은 혈당 범위 가중치</string>
    <string name="openapsama_higher_ISFrange_weight_summary">혈당이 목표보다 높을 때 적용되는 가중치입니다. ISF를 강하게 하므로 인슐린 주입이 늘어날 수 있습니다.\n\n기본값 0.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_smb_delivery_ratio_bg_range">SMB 주입 비율 혈당 범위</string>
    <string name="openapsama_smb_delivery_ratio_bg_range_summary">기본값: 0. 선형으로 증가하는 SMB 주입 비율은 혈당 범위 [target_bg, target_bg+bg_range]에 대응합니다.\ntarget_bg에서 SMB 비율은 smb_delivery_ratio_min이고, target_bg+bg_range에서는 smb_delivery_ratio_max입니다\n0이면 선형으로 증가하는 SMB 비율은 꺼지고 고정된 smb_delivery_ratio를 사용합니다.</string>
    <string name="pref_title_pp_weight">식후 ISF 가중치</string>
    <string name="openapsama_pp_ISF_weight_summary">혈당이 오르고 있을 때 적용되는 가중치입니다. ISF를 강하게 하므로 인슐린 주입이 늘어날 수 있습니다.\n\n기본값 0.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_dura_weight">지속 시간 ISF 가중치</string>
    <string name="openapsama_dura_ISF_weight_summary">높은 혈당이 오래 일정하게 유지될 때 적용되는 가중치입니다. ISF를 강하게 하므로 인슐린 주입이 늘어날 수 있습니다.\n\n기본값 0.0은 이 효과를 사실상 끕니다.</string>
    <string name="pref_title_smb_delivery_ratio">SMB 주입 비율</string>
    <string name="openapsama_smb_delivery_ratio_summary">기본값: 0.5 이것은 또 하나의 중요한 OpenAPS 안전 한도이며, 필요한 총 인슐린 중 어느 정도를 SMB로 주입할 수 있는지 정합니다. 보호자의 휴대폰에서 동시에 SMB 요청을 설정하여 위험한 상황이 되는 것을 막기 위한 것입니다. 이 실험적인 값은 천천히 신중하게 높이십시오.</string>
    <string name="pref_title_smb_delivery_ratio_min">SMB 주입 비율 최소값</string>
    <string name="openapsama_smb_delivery_ratio_min_summary">기본값: 0.5 위의 고정값 대신 선형으로 증가하는 비율의 하한입니다.</string>
    <string name="pref_title_smb_delivery_ratio_max">SMB 주입 비율 최대값</string>
    <string name="openapsama_smb_delivery_ratio_max_summary">기본값: 0.5 위의 고정값 대신 선형으로 증가하는 비율의 상한입니다.</string>
    <string name="pref_title_smb_max_range_extension">SMB 최대 범위 확장</string>
    <string name="openapsama_smb_max_range_extension_summary">기본값: 1 이것은 또 하나의 중요한 OpenAPS 안전 한도이며, 일반적인 120 maxSMB/maxUAM 분을 몇 배까지 넘을 수 있는지 정합니다. 이 실험적인 값은 천천히 신중하게 높이십시오.</string>
