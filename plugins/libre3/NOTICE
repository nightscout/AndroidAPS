  gatt/Libre3BluetoothUuids.kt            <- BLE/LibreSensorGATT.swift
  gatt/Libre3BleFraming.kt                <- BLE/FrameAssembler.swift
  nfc/Libre3NfcCommands.kt                <- NFCActivationModels.swift, and the
