  parse/Libre3DataFrame.kt                <- DataPlane/DataFrame.swift
  parse/Libre3GlucoseFrameAssembler.kt    <- DataPlane/DataPlaneDecoder.swift
  parse/Libre3GlucoseParser.kt            <- DataPlane/RealtimeGlucoseReading.swift
