    },
    "dynPref": {
        "reservoirGauge": {
            "prefKey": "key_show_reservoir_level",
            "true": {
                "valueKey": "reservoir", "minData": 0, "maxData": 204, "invalidImage": "Empty",
                "image1": "Reservoir000", "image2": "Reservoir004", "image3": "Reservoir008",
                "image4": "Reservoir012", "image5": "Reservoir016", "image6": "Reservoir020",
                "image7": "Reservoir024", "image8": "Reservoir028", "image9": "Reservoir032",
                "image10": "Reservoir036", "image11": "Reservoir040", "image12": "Reservoir044",
                "image13": "Reservoir048", "image14": "Reservoir052", "image15": "Reservoir056",
                "image16": "Reservoir060", "image17": "Reservoir064", "image18": "Reservoir068",
                "image19": "Reservoir072", "image20": "Reservoir076", "image21": "Reservoir080",
                "image22": "Reservoir084", "image23": "Reservoir088", "image24": "Reservoir092",
                "image25": "Reservoir096", "image26": "Reservoir100", "image27": "Reservoir104",
                "image28": "Reservoir108", "image29": "Reservoir112", "image30": "Reservoir116",
                "image31": "Reservoir120", "image32": "Reservoir124", "image33": "Reservoir128",
                "image34": "Reservoir132", "image35": "Reservoir136", "image36": "Reservoir140",
                "image37": "Reservoir144", "image38": "Reservoir148", "image39": "Reservoir152",
                "image40": "Reservoir156", "image41": "Reservoir160", "image42": "Reservoir164",
                "image43": "Reservoir168", "image44": "Reservoir172", "image45": "Reservoir176",
                "image46": "Reservoir180", "image47": "Reservoir184", "image48": "Reservoir188",
                "image49": "Reservoir192", "image50": "Reservoir196", "image51": "Reservoir200"
            },
            "false": { "valueKey": "day", "image1": "Empty" }
        },
        "glucoseUnits": {
            "prefKey": "key_show_bg",
            "true": { "dynPref": "units" },
            "false": { "valueKey": "day", "textvalue1": "" }
        },
        "units": {
            "prefKey": "key_units",
            "true": { "valueKey": "day", "textvalue1": "mg/dL" },
            "false": { "valueKey": "day", "textvalue1": "mmol/L" }
        },
        "basalLabel": {
            "prefKey": "key_show_temp_basal",
            "true": { "valueKey": "day", "textvalue1": "BASAL" },
            "false": { "valueKey": "day", "textvalue1": "" }
        },
        "iobTotal": {
            "prefKey": "key_show_detailed_iob",
            "true": { "valueKey": "day", "fontColor1": "#65DEED" },
            "false": { "valueKey": "day", "textvalue1": "" }
        },
        "iobValue": {
            "prefKey": "key_show_detailed_iob",
            "true": { "valueKey": "day", "topOffset1": 38, "leftOffset1": -16, "textsize1": 12, "fontColor1": "#ABB8C2" },
            "false": { "valueKey": "day", "topOffset1": 0, "leftOffset1": 0, "textsize1": 32, "fontColor1": "#65DEED" }
        },
        "iobIcon": {
            "prefKey": "key_show_iob",
            "true": { "valueKey": "day", "image1": "IobIcon", "textvalue1": "" },
            "false": { "valueKey": "day", "image1": "Empty", "textvalue1": "" }
        },
        "cobIcon": {
            "prefKey": "key_show_cob",
            "true": { "valueKey": "day", "image1": "CobIcon", "textvalue1": "" },
            "false": { "valueKey": "day", "image1": "Empty", "textvalue1": "" }
        },
        "reservoirLabel": {
            "prefKey": "key_show_reservoir_level",
            "true": { "valueKey": "day", "textvalue1": "RES / U" },
            "false": { "valueKey": "day", "textvalue1": "" }
        }
    }
