{
    "metadata": {
        "name": "AAPS Sport",
        "author": "OpenCode",
        "created_at": "16/10/2026",
        "author_version": "1.14",
        "cwf_version": "1.0",
        "comment": "Digital sport dashboard. Lower-right light-blue reservoir gauge: 0-200 U, 4 U steps. Native basal text, COB, IOB, trend and warning hooks. No chart, battery display or app changes."
    },
    "enableSecond": false,
    "pointSize": 2,
    "highColor": "#FFD166",
    "midColor": "#B5F46A",
    "lowColor": "#FF727C",
    "reservoirColor": "#65DEED",
    "background": {
        "width": 400, "height": 400, "leftmargin": 0, "topmargin": 0,
        "visibility": "visible"
    },
    "chart": {
        "width": 1, "height": 1, "leftmargin": 200, "topmargin": 200,
        "visibility": "gone"
    },
    "cover_chart": {
        "width": 208, "height": 208, "leftmargin": 192, "topmargin": 192,
        "visibility": "visible", "dynPref": "reservoirGauge"
    },
    "direction": {
        "width": 146, "height": 146, "leftmargin": 59, "topmargin": 24,
        "visibility": "visible"
    },
    "freetext1": {
        "width": 72, "height": 20, "leftmargin": 96, "topmargin": 49,
        "visibility": "visible", "textsize": 12, "gravity": "center",
        "font": "roboto_condensed_regular", "fontColor": "#ABB8C2", "dynPref": "glucoseUnits"
    },
    "sgv": {
        "width": 110, "height": 54, "leftmargin": 77, "topmargin": 65,
        "visibility": "visible", "textsize": 40, "gravity": "center",
        "font": "roboto_condensed_bold", "fontStyle": "normal"
    },
    "timestamp": {
        "width": 60, "height": 28, "leftmargin": 102, "topmargin": 116,
        "visibility": "visible", "textsize": 18, "gravity": "center",
