<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_seconds"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/custom_pref_show_seconds"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_show_week_number"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_weeknumber"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_dark"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_dark"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_match_divider"
        android:summary="Status bar divider background matches watchface background"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_matching_divider"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_show_date"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_date"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_include_external"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_include_external"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="@string/key_switch_external"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_switch_external"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <ListPreference
        android:defaultValue="off"
        android:entries="@array/watchface_simplify_ui_name"
        android:entryValues="@array/watchface_simplify_ui_values"
        android:key="@string/key_simplify_ui"
        android:title="@string/pref_simplify_ui"
        android:summary="%s" />

    <!-- Each complication slot is a pair: its "Show" toggle, then its data source picker. The
         picker declares android:dependency on the toggle, so turning the slot off also grays out
         the picker. That is cosmetic only - dependency disables a row, it never hides it - and is
         a complement to filtering this screen by what the loaded watch face actually shows, not a
         substitute for it. -->
    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_complication_1"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_complication1"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <Preference
        android:dependency="@string/key_show_complication_1"
        android:key="@string/key_complication_1"
        android:title="@string/pref_complication_1" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_complication_2"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_complication2"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <Preference
        android:dependency="@string/key_show_complication_2"
        android:key="@string/key_complication_2"
        android:title="@string/pref_complication_2" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_complication_3"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_complication3"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <Preference
        android:dependency="@string/key_show_complication_3"
        android:key="@string/key_complication_3"
        android:title="@string/pref_complication_3" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_complication_4"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_complication4"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <Preference
        android:dependency="@string/key_show_complication_4"
        android:key="@string/key_complication_4"
        android:title="@string/pref_complication_4" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="@string/key_show_complication_5"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"
        android:title="@string/pref_show_complication5"
        app:wear_iconOff="@drawable/settings_off"
        app:wear_iconOn="@drawable/settings_on" />

    <Preference
        android:dependency="@string/key_show_complication_5"
        android:key="@string/key_complication_5"
        android:title="@string/pref_complication_5" />

</PreferenceScreen>
