<?xml version="1.0" encoding="utf-8"?>
<!-- Direct to watch: a watch, and at its upper right the round sensor it reads, with one arc for the link. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Watch straps, above and below the case -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M7,4.6 h5 v3.6 h-5 z"/>
  <path
      android:fillColor="@android:color/white"
      android:pathData="M7,18.8 h5 v3.6 h-5 z"/>

  <!-- Watch case: a ring, centre (9.5, 13.5), radius 5.5 -->
  <path
      android:fillColor="#00000000"
      android:strokeColor="@android:color/white"
      android:strokeWidth="1.6"
      android:pathData="M9.5,13.5 m-5.5,0 a5.5,5.5 0,1 1,11 0 a5.5,5.5 0,1 1,-11 0"/>

  <!-- Sensor: a filled disc, centre (19, 6), radius 2.6 -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M19,6 m-2.6,0 a2.6,2.6 0,1 1,5.2 0 a2.6,2.6 0,1 1,-5.2 0"/>

  <!-- The link: a quarter arc around the sensor, on the side of the watch -->
  <path
      android:fillColor="#00000000"
      android:strokeColor="@android:color/white"
      android:strokeWidth="1.4"
      android:strokeLineCap="round"
      android:pathData="M14.4,6 A4.6,4.6 0,0 0,19 10.6"/>
</vector>
